[Unit]
Description=Lab Health Node Reporter Service
After=network.target docker.service

[Service]
Type=simple
User=graxel
WorkingDirectory=/home/graxel/repos/lab-health
ExecStart=/home/graxel/.cargo/bin/uv run python reporter.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
