[Unit]
Description=Lab Health Monitoring Controller Service
After=network.target postgresql.service

[Service]
Type=simple
User=graxel
WorkingDirectory=/home/graxel/repos/lab-health
ExecStart=/home/graxel/.cargo/bin/uv run python monitor.py
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
